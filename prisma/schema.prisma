generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Locale {
  en
  pt_BR
}

enum AtsType {
  GREENHOUSE
  LEVER
  ASHBY
  WORKDAY
  BAMBOOHR
  SMARTRECRUITERS
  TEAMTAILOR
  GUPY
  KENOBY
  SOLIDES
  LINKEDIN
  INDEED
  CATHO
  APINFO
  CUSTOM
  UNKNOWN
}

enum SourceType {
  ATS
  CAREERS
  JOB_BOARD
  TELEGRAM
  SLACK
  OTHER
}

enum SourceRunStatus {
  SUCCESS
  PARTIAL
  FAILED
}

enum JobStatus {
  NEW
  SCORED
  FAVORITED
  REJECTED
  APPROVED
  APPLIED
  INTERVIEW
  OFFER
  CLOSED
}

enum ApplicationStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PENDING_APPLY
  APPLIED
  FAILED
  MANUAL_REQUIRED
  INTERVIEW
  REJECTED
  OFFER
  WITHDRAWN
}

enum ResumeStack {
  JS_TS
  DOTNET
  PHP
  OTHER
}

enum ActorType {
  USER
  SYSTEM
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String?
  passwordHash String?
  locale       Locale    @default(en)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  resumes      Resume[]
  jobScores    JobScore[]
  applications Application[]
  coverLetters CoverLetter[]
  notifications Notification[]
  credentials  CredentialVault[]

  @@map("users")
}

model Resume {
  id           String      @id @default(uuid())
  userId       String
  name         String
  stack        ResumeStack
  locale       Locale      @default(en)
  summary      String?     @db.Text
  contentText  String      @db.LongText
  filePath     String?
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  matches      JobResumeMatch[]
  applications Application[]
  coverLetters CoverLetter[]

  @@index([userId])
  @@index([stack])
  @@index([locale])
  @@unique([userId, stack, locale])
  @@map("resumes")
}

model Company {
  id               String   @id @default(uuid())
  name             String
  website          String?
  careersUrl       String?
  country          String?
  atsType          AtsType?
  isRemoteFriendly Boolean?
  sourceMeta       Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sources Source[]
  jobs    Job[]

  @@index([name])
  @@index([atsType])
  @@index([country])
  @@map("companies")
}

model Source {
  id           String           @id @default(uuid())
  name         String
  type         SourceType
  atsType      AtsType?
  baseUrl      String           @db.Text
  companyId    String?
  enabled      Boolean          @default(true)
  scheduleCron String?
  lastRunAt    DateTime?
  lastStatus   SourceRunStatus?
  config       Json?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  company    Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  jobs       Job[]
  scrapeRuns ScrapeRun[]

  @@index([enabled])
  @@index([type])
  @@index([atsType])
  @@index([companyId])
  @@map("sources")
}

model Job {
  id              String    @id @default(uuid())
  companyId       String?
  sourceId        String
  externalId      String?
  title           String
  descriptionHtml String?   @db.LongText
  descriptionText String    @db.LongText
  location        String?
  country         String?
  isRemote        Boolean?
  employmentType  String?
  seniority       String?
  salaryMin       Decimal?  @db.Decimal(12, 2)
  salaryMax       Decimal?  @db.Decimal(12, 2)
  salaryCurrency  String?
  salaryRaw       String?
  applyUrl        String    @db.Text
  postedAt        DateTime?
  scrapedAt       DateTime  @default(now())
  contentHash     String
  status          JobStatus @default(NEW)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company      Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  source       Source           @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  technologies JobTechnology[]
  scores       JobScore[]
  matches      JobResumeMatch[]
  applications Application[]
  coverLetters CoverLetter[]
  artifacts    ScrapeArtifact[]

  @@unique([sourceId, externalId])
  @@index([contentHash])
  @@index([status])
  @@index([postedAt])
  @@index([scrapedAt])
  @@index([companyId])
  @@index([isRemote])
  @@index([country])
  @@map("jobs")
}

model Technology {
  id       String  @id @default(uuid())
  name     String  @unique
  category String?

  jobs JobTechnology[]

  @@map("technologies")
}

model JobTechnology {
  jobId        String
  technologyId String
  confidence   Float?

  job        Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  technology Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@id([jobId, technologyId])
  @@map("job_technologies")
}

model JobScore {
  id            String   @id @default(uuid())
  jobId         String
  userId        String
  score         Int
  breakdown     Json
  explanation   String?  @db.Text
  model         String?
  promptVersion String?
  createdAt     DateTime @default(now())

  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([score])
  @@index([jobId])
  @@index([userId])
  @@map("job_scores")
}

model JobResumeMatch {
  id            String   @id @default(uuid())
  jobId         String
  resumeId      String
  matchScore    Int
  reasons       Json
  isRecommended Boolean  @default(false)
  createdAt     DateTime @default(now())

  job    Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@unique([jobId, resumeId])
  @@map("job_resume_matches")
}

model Application {
  id                String            @id @default(uuid())
  jobId             String
  userId            String
  resumeId          String
  coverLetterId     String?
  status            ApplicationStatus @default(DRAFT)
  approvedAt        DateTime?
  appliedAt         DateTime?
  failureCode       String?
  failureMessage    String?           @db.Text
  provider          String?
  externalReference String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  job         Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume      Resume       @relation(fields: [resumeId], references: [id], onDelete: Restrict)
  coverLetter CoverLetter? @relation(fields: [coverLetterId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([appliedAt])
  @@index([userId])
  @@index([jobId])
  @@map("applications")
}

model CoverLetter {
  id            String   @id @default(uuid())
  userId        String
  jobId         String
  resumeId      String
  content       String   @db.LongText
  locale        String
  model         String?
  promptVersion String?
  createdAt     DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  job          Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  resume       Resume        @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  applications Application[]

  @@index([userId])
  @@index([jobId])
  @@map("cover_letters")
}

model ScrapeRun {
  id           String          @id @default(uuid())
  sourceId     String
  startedAt    DateTime        @default(now())
  finishedAt   DateTime?
  status       SourceRunStatus
  jobsFound    Int             @default(0)
  jobsUpserted Int             @default(0)
  errorSummary String?         @db.Text

  source    Source           @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  artifacts ScrapeArtifact[]

  @@index([sourceId])
  @@index([startedAt])
  @@map("scrape_runs")
}

model ScrapeArtifact {
  id          String   @id @default(uuid())
  scrapeRunId String?
  jobId       String?
  contentType String
  storagePath String
  createdAt   DateTime @default(now())

  scrapeRun ScrapeRun? @relation(fields: [scrapeRunId], references: [id], onDelete: SetNull)
  job       Job?       @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([scrapeRunId])
  @@index([jobId])
  @@map("scrape_artifacts")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String    @db.Text
  payload   Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

model CredentialVault {
  id         String   @id @default(uuid())
  userId     String
  provider   String
  ciphertext String   @db.Text
  iv         String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@map("credential_vault")
}

model AuditLog {
  id         String    @id @default(uuid())
  actorType  ActorType
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime  @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
