# App
APP_URL=http://localhost:3000
NODE_ENV=development

# Database (Docker Compose defaults)
DATABASE_URL="mysql://jobhunter:jobhunter@127.0.0.1:3306/jobhunter"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_TRUST_HOST=true

# Seed user (used by prisma/seed.ts)
SEED_USER_EMAIL=admin@jobhunter.local
SEED_USER_PASSWORD=ChangeMe123!
SEED_USER_NAME=Admin

# AI (Phase 4+)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
HIGH_SCORE_THRESHOLD=75

# Credential vault encryption (Phase 6+) — openssl rand -hex 32
ENCRYPTION_KEY=

# Playwright auto-apply (Phase 6)
# Leave enabled (default). Set to false to hide/block automation.
PLAYWRIGHT_AUTO_APPLY_ENABLED=true
# Headless browser (set false to watch the browser while developing strategies)
PLAYWRIGHT_HEADLESS=true
# Dangerous: actually click Submit on live ATS forms. Default is fill-only → MANUAL_REQUIRED.
PLAYWRIGHT_AUTO_SUBMIT=false
